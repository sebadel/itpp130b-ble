#!/usr/bin/env python3
"""CUPS filter: renders PDF/PostScript to bitmap TSPL for BLE thermal printers."""

import sys
import os
import subprocess
import tempfile
import math
import glob
import logging

logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')
log = logging.getLogger('ble-tspl-filter')

LABEL_WIDTH_MM = 100
LABEL_HEIGHT_MM = 150
DPI = 203
GAP_MM = 3
DENSITY = 8
SPEED = 4

LABEL_WIDTH_PX = int(round(LABEL_WIDTH_MM / 25.4 * DPI))
LABEL_HEIGHT_PX = int(round(LABEL_HEIGHT_MM / 25.4 * DPI))


def _read_pbm(path):
    with open(path, 'rb') as f:
        magic = f.readline().strip()
        if magic != b'P4':
            raise ValueError(f'unsupported PBM format: {magic!r}')

        line = f.readline()
        while line.startswith(b'#'):
            line = f.readline()
        width, height = map(int, line.split())
        return width, height, f.read()


def _invert_pbm(width, height, data):
    """Invert PBM pixels for the printer's BITMAP polarity."""
    row_bytes = math.ceil(width / 8)
    padding = row_bytes * 8 - width
    last_mask = 0xFF if not padding else (0xFF << padding) & 0xFF
    result = bytearray()
    for offset in range(0, len(data), row_bytes):
        row = bytearray(value ^ 0xFF for value in data[offset:offset + row_bytes])
        if row:
            row[-1] &= last_mask
        result.extend(row)
    return bytes(result)


def _rotate_pbm_90(width, height, data):
    """Rotate packed PBM pixels clockwise by 90 degrees."""
    source_row_bytes = math.ceil(width / 8)
    rotated_width = height
    rotated_height = width
    rotated_row_bytes = math.ceil(rotated_width / 8)
    result = bytearray(rotated_row_bytes * rotated_height)
    for y in range(height):
        for x in range(width):
            source_bit = (data[y * source_row_bytes + x // 8] >> (7 - x % 8)) & 1
            if source_bit:
                new_x = height - 1 - y
                new_y = x
                result[new_y * rotated_row_bytes + new_x // 8] |= 1 << (7 - new_x % 8)
    return rotated_width, rotated_height, bytes(result)


def render_pdf_to_bitmaps(pdf_path, landscape=False, rotate=False):
    """Render every PDF page to a monochrome PBM at printer resolution."""
    with tempfile.TemporaryDirectory() as directory:
        prefix = os.path.join(directory, 'page')

        render_landscape = landscape and not rotate
        width_px = LABEL_HEIGHT_PX if render_landscape else LABEL_WIDTH_PX
        height_px = LABEL_WIDTH_PX if render_landscape else LABEL_HEIGHT_PX
        subprocess.run([
            'pdftoppm', '-mono',
            '-r', str(DPI),
            '-scale-to-x', str(width_px),
            '-scale-to-y', str(height_px),
            pdf_path, prefix
        ], check=True, timeout=30)

        pages = []
        page_paths = sorted(
            glob.glob(prefix + '-*.pbm'),
            key=lambda path: int(path.rsplit('-', 1)[1].split('.', 1)[0]),
        )
        for pbm_path in page_paths:
            width, height, data = _read_pbm(pbm_path)
            data = _invert_pbm(width, height, data)
            if rotate:
                width, height, data = _rotate_pbm_90(width, height, data)
            pages.append((width, height, data))
        if not pages:
            raise ValueError('pdftoppm produced no pages')

        for width, height, data in pages:
            log.info(f"pdftoppm rendered {width}x{height} PBM ({len(data)} bytes)")
        return pages


def ps_to_pdf(ps_data):
    """Convert PostScript to PDF using ghostscript."""
    with tempfile.NamedTemporaryFile(suffix='.ps', delete=False) as f:
        f.write(ps_data)
        ps_path = f.name
    pdf_path = ps_path.replace('.ps', '.pdf')
    try:
        subprocess.run([
            'gs', '-q', '-dNOPAUSE', '-dBATCH', '-sDEVICE=pdfwrite',
            f'-sOutputFile={pdf_path}', ps_path
        ], check=True, timeout=30)
        log.info(f"Converted PS to PDF: {os.path.getsize(pdf_path)} bytes")
        return pdf_path
    except Exception as e:
        log.error(f"PS to PDF conversion failed: {e}")
        return None
    finally:
        try:
            os.unlink(ps_path)
        except OSError:
            pass


def pdf_is_landscape(pdf_path):
    """Use the source page orientation when CUPS did not provide one."""
    try:
        result = subprocess.run(['pdfinfo', pdf_path], capture_output=True,
                                text=True, check=True, timeout=10)
        for line in result.stdout.splitlines():
            if line.startswith('Page size:'):
                width, height = (float(value) for value in line.split()[2:4])
                return width > height
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    return False


MAX_STRIP_ROWS = 100


def build_bitmap_tspl(width_px, height_px, bitmap_data, landscape=False):
    """Build one TSPL label from PBM data (PBM 1=black, matching TSPL)."""
    row_bytes = math.ceil(width_px / 8)
    total_rows = height_px

    canvas_width_px = LABEL_HEIGHT_PX if landscape else LABEL_WIDTH_PX
    canvas_height_px = LABEL_WIDTH_PX if landscape else LABEL_HEIGHT_PX
    canvas_width_mm = LABEL_HEIGHT_MM if landscape else LABEL_WIDTH_MM
    canvas_height_mm = LABEL_WIDTH_MM if landscape else LABEL_HEIGHT_MM
    x = (canvas_width_px - width_px) // 2
    y_start = (canvas_height_px - height_px) // 2

    result = (
        f"SIZE {canvas_width_mm} mm,{canvas_height_mm} mm\r\n"
        f"GAP {GAP_MM} mm,0 mm\r\n"
        f"DENSITY {DENSITY}\r\n"
        f"SPEED {SPEED}\r\n"
        f"CLS\r\n"
    ).encode('ascii')

    rows_sent = 0
    while rows_sent < total_rows:
        rows_this_strip = min(MAX_STRIP_ROWS, total_rows - rows_sent)
        offset = rows_sent * row_bytes
        strip_data = bitmap_data[offset:offset + rows_this_strip * row_bytes]

        y = y_start + rows_sent
        result += f"BITMAP {x},{y},{row_bytes},{rows_this_strip},0,".encode('ascii')
        result += strip_data
        result += b"\r\n"

        rows_sent += rows_this_strip

    result += b"PRINT 1\r\n"
    return result


def text_to_tspl(text):
    """Fallback: convert plain text to TSPL TEXT commands."""
    lines = text.strip().split('\n')

    tspl = f"SIZE {LABEL_WIDTH_MM},{LABEL_HEIGHT_MM}\n"
    tspl += "GAP 3,0\n"
    tspl += "DENSITY 8\n"
    tspl += "SPEED 4\n"
    tspl += "CLS\n"

    y = 10
    for line in lines:
        if y > LABEL_HEIGHT_MM * 3.7 - 20:
            break
        if line.strip():
            escaped = line.replace('"', '\\"')
            max_chars = 28
            while escaped:
                chunk = escaped[:max_chars]
                escaped = escaped[max_chars:]
                tspl += f'TEXT 10,{y},"FONT 0",0,1,1,"{chunk}"\n'
                y += 28
        else:
            y += 14

    tspl += "PRINT 1\n"
    return tspl.encode('latin-1')


def is_postscript(data):
    return data[:2] == b'%!'


def is_pdf(data):
    return data[:5] == b'%PDF-'


def main():
    log.info(f"Filter called with {len(sys.argv)} args")

    if len(sys.argv) < 6:
        log.error(f"Not enough args: {len(sys.argv)}")
        sys.exit(1)

    options = sys.argv[5].split()
    landscape = 'landscape' in options or 'orientation-requested=4' in options

    if len(sys.argv) >= 7 and sys.argv[6] and sys.argv[6] != "-":
        filepath = sys.argv[6]
        log.info(f"Reading from file: {filepath}")
        with open(filepath, 'rb') as f:
            data = f.read()
    else:
        log.info("Reading from stdin")
        data = sys.stdin.buffer.read()

    log.info(f"Read {len(data)} bytes")

    if len(data) == 0:
        log.warning("No data to print")
        sys.exit(0)

    # Try bitmap rendering for PDF/PostScript
    pdf_path = None
    pages = []
    try:
        try:
            if is_pdf(data):
                log.info(f"Detected PDF ({len(data)} bytes), rendering to bitmap")
                with tempfile.NamedTemporaryFile(suffix='.pdf', delete=False) as f:
                    f.write(data)
                    pdf_path = f.name
                source_landscape = pdf_is_landscape(pdf_path)
                rotate = landscape and not source_landscape
                landscape = landscape or source_landscape
                pages = render_pdf_to_bitmaps(pdf_path, landscape=landscape, rotate=rotate)
            elif is_postscript(data):
                log.info(f"Detected PostScript ({len(data)} bytes), converting to PDF then bitmap")
                pdf_path = ps_to_pdf(data)
                if pdf_path:
                    source_landscape = pdf_is_landscape(pdf_path)
                    rotate = landscape and not source_landscape
                    landscape = landscape or source_landscape
                    pages = render_pdf_to_bitmaps(pdf_path, landscape=landscape, rotate=rotate)
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            log.warning(f"Bitmap rendering failed: {exc}")

        if not is_pdf(data) and not is_postscript(data):
            log.info(f"Plain text input ({len(data)} bytes), using TEXT commands")
            text = data.decode('utf-8', errors='replace')
            tspl = text_to_tspl(text)
            log.info(f"Generated {len(tspl)} bytes of TSPL TEXT data")
            sys.stdout.buffer.write(tspl)
            sys.stdout.buffer.flush()
            return

        if pages:
            tspl = b''.join(build_bitmap_tspl(width, height, bitmap, landscape=landscape)
                            for width, height, bitmap in pages)
            log.info(f"Rendered {len(pages)} page(s), generated {len(tspl)} bytes of TSPL BITMAP data")
            sys.stdout.buffer.write(tspl)
            sys.stdout.buffer.flush()
        else:
            log.warning("Bitmap rendering failed, falling back to text extraction")
            if is_pdf(data):
                result = subprocess.run(
                    ['pdftotext', '-layout', pdf_path or '/dev/null', '-'],
                    capture_output=True, timeout=30
                )
                text = result.stdout.decode('utf-8', errors='replace')
            elif is_postscript(data):
                result = subprocess.run(
                    ['gs', '-q', '-dNOPAUSE', '-dBATCH', '-sDEVICE=txtwrite',
                     '-sOutputFile=-', '/dev/stdin'],
                    input=data, capture_output=True, timeout=30
                )
                text = result.stdout.decode('utf-8', errors='replace')
            else:
                text = data.decode('utf-8', errors='replace')

            if text and text.strip():
                tspl = text_to_tspl(text)
                log.info(f"Fallback: generated {len(tspl)} bytes of TSPL TEXT data")
                sys.stdout.buffer.write(tspl)
                sys.stdout.buffer.flush()
            else:
                log.error("No printable content found")
                sys.exit(1)

    finally:
        if pdf_path:
            try:
                os.unlink(pdf_path)
            except OSError:
                pass


if __name__ == '__main__':
    main()
