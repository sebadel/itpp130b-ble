#!/usr/bin/env python3
"""CUPS backend for BLE thermal label printers (ITPP130B, etc.)."""

import sys
import os
import asyncio
import logging

logging.basicConfig(level=logging.DEBUG, format='%(asctime)s %(levelname)s %(message)s')
log = logging.getLogger('ble-backend')

LABEL_WIDTH_MM = 150
LABEL_HEIGHT_MM = 100

BLE_WRITE_CHARS = [
    "0000fff2-0000-1000-8000-00805f9b34fb",
    "49535343-8841-43f4-a8d4-ecbe34729bb3",
]

EXCLUDE_CHARS = [
    "49535343-6daa-4d02-abf6-19569aca69fe",
    "0000fff1-0000-1000-8000-00805f9b34fb",
    "0000fff3-0000-1000-8000-00805f9b34fb",
    "49535343-1e4d-4bd9-ba61-23c647249616",
]


def wrap_in_tspl(raw_data):
    text = raw_data.decode('latin-1', errors='replace')
    lines = text.strip().split('\n')

    tspl = f"SIZE {LABEL_WIDTH_MM},{LABEL_HEIGHT_MM}\n"
    tspl += "GAP 3,0\n"
    tspl += "DENSITY 8\n"
    tspl += "SPEED 4\n"
    tspl += "CLS\n"

    y = 50
    for line in lines:
        if line.strip():
            escaped = line.replace('"', '\\"')
            tspl += f'TEXT 50,{y},"FONT 0",0,1,1,"{escaped}"\n'
            y += 30

    tspl += "PRINT 1\n"
    return tspl.encode('latin-1')


async def ble_send(mac_addr, data):
    from bleak import BleakClient, BleakScanner

    try:
        header = data[:20].decode('ascii', errors='replace').upper()
    except Exception:
        header = ""

    is_tspl = any(kw in header for kw in ["SIZE", "CLS", "TEXT ", "PRINT", "GRAPHIC", "BARCODE"])

    if is_tspl:
        log.info("Data is already TSPL, sending as-is")
        send_data = data
    else:
        log.info(f"Wrapping {len(data)} bytes of raw text in TSPL commands")
        send_data = wrap_in_tspl(data)

    log.info(f"Scanning for {mac_addr}...")
    device = await BleakScanner.find_device_by_address(mac_addr, timeout=15)
    if not device:
        device = await BleakScanner.find_device_by_name("ITPP130B", timeout=10)
    if not device:
        log.error(f"Device {mac_addr} not found")
        print(f"ERROR: Device {mac_addr} not found via BLE scan", file=sys.stderr)
        sys.exit(1)

    log.info(f"Found: {device.name} [{device.address}]")
    async with BleakClient(device) as client:
        log.info(f"Connected, MTU={client.mtu_size}")

        write_char = None
        uuid_lower = [c.lower() for c in BLE_WRITE_CHARS]
        excl_lower = [c.lower() for c in EXCLUDE_CHARS]

        for service in client.services:
            for char in service.characteristics:
                char_uuid_str = str(char.uuid).lower()
                if char_uuid_str in uuid_lower:
                    write_char = char.uuid
                    log.info(f"Using preferred characteristic: {char.uuid}")
                    break
            if write_char:
                break

        if not write_char:
            for service in client.services:
                for char in service.characteristics:
                    char_uuid_str = str(char.uuid).lower()
                    if 'write-without-response' in char.properties or 'write' in char.properties:
                        if char_uuid_str not in excl_lower:
                            write_char = char.uuid
                            log.info(f"Using fallback characteristic: {char.uuid} ({char.properties})")
                            break
                if write_char:
                    break

        if not write_char:
            log.error("No suitable write characteristic found")
            print("ERROR: No writable BLE characteristic found", file=sys.stderr)
            sys.exit(1)

        log.info(f"Sending {len(send_data)} bytes of TSPL data")
        mtu = client.mtu_size - 3
        offset = 0
        total = len(send_data)
        while offset < total:
            chunk = send_data[offset:offset + mtu]
            try:
                await client.write_gatt_char(write_char, chunk, response=False)
            except Exception as e:
                log.warning(f"Write error at {offset}: {e}, retrying")
                await asyncio.sleep(0.1)
                await client.write_gatt_char(write_char, chunk, response=False)
            offset += len(chunk)
            if offset < total:
                await asyncio.sleep(0.02)

        log.info(f"Sent {total} bytes")
        await asyncio.sleep(1)


def main():
    log.info(f"Backend called with {len(sys.argv)} args")

    if len(sys.argv) < 2:
        print("direct ble:/// \"Unknown\" \"BLE Thermal Printer\"")
        sys.exit(0)

    argv1 = sys.argv[1]

    if len(sys.argv) == 2 and not argv1.isdigit():
        print("direct ble:/// \"Unknown\" \"BLE Thermal Printer\"")
        sys.exit(0)

    if len(sys.argv) < 6:
        log.error(f"Not enough args: {len(sys.argv)}")
        sys.exit(1)

    device_uri = os.environ.get('DEVICE_URI', '')
    if not device_uri.startswith('ble://'):
        log.error(f"Invalid DEVICE_URI: {device_uri}")
        sys.exit(1)

    mac_raw = device_uri[6:]
    if ':' not in mac_raw and len(mac_raw) == 12:
        mac = ':'.join(mac_raw[i:i+2] for i in range(0, 12, 2))
    else:
        mac = mac_raw

    log.info(f"Print job for {mac}")

    if len(sys.argv) >= 7 and sys.argv[6] != "-":
        filepath = sys.argv[6]
        log.info(f"Reading from file: {filepath}")
        with open(filepath, 'rb') as f:
            data = f.read()
    else:
        log.info("Reading from stdin")
        data = sys.stdin.buffer.read()

    log.info(f"Read {len(data)} bytes")

    if len(data) == 0:
        log.warning("No data to print")
        sys.exit(0)

    asyncio.run(ble_send(mac, data))
    log.info("Done")


if __name__ == '__main__':
    main()
